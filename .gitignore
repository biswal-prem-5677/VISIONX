# ============================================
# VisionX — Git Ignore
# ============================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# --- Virtual Environment ---
.venv/
venv/
env/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# --- Environment ---
.env
.env.local
.env.*.local

# --- AI Models ---
*.pt
*.onnx
*.trt
*.engine
models/

# --- Data ---
data/logs/
data/embeddings/
data/media/

# --- Local development database ---
# server/db/session.py falls back to a SQLite file when DATABASE_URL is unset.
# It is a developer's scratch state, never a deployment target.
*.db
*.db-journal
*.sqlite3

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
*.cover

# --- Build ---
*.pyc
*.pyo

# --- Node.js (for future client/) ---
node_modules/
.next/
.turbo/
*.tsbuildinfo

# --- Docker ---
docker-compose.override.yml

# --- Sentry ---
.sentryclirc

# --- Misc ---
*.log
*.bak
*.tmp

# --- Vite Cache ---
.vite/

# --- Recordings ---
recordings/
